// Athletex PostgreSQL Relational Database Schema (Prisma ORM)
// Designed for dynamic multi-sport athlete progression and bi-weekly assessment cycles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. USERS & IDENTITY
// -------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatar       String?
  role         String   @default("ATHLETE") // ATHLETE, COACH, ADMIN
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  sportProfiles      UserSportProfile[]
  pillarProgress     UserPillarProgress[]
  trajectoryRecords  PerformanceTrajectoryRecord[]
  assessmentResults  UserAssessmentResult[]
  eventRegistrations UserEventRegistration[]
  competitionResults UserCompetitionResult[]

  @@map("users")
}

// -------------------------------------------------------------
// 2. SPORTS CATALOG
// -------------------------------------------------------------
model Sport {
  id               String   @id // e.g. 'football', 'cricket', 'basketball'
  name             String   @unique // 'Football', 'Cricket'
  slug             String   @unique
  icon             String   @default("Activity")
  color            String   @default("#00F0FF")
  description      String   @db.Text
  popularPositions String?  @map("popular_positions") @db.Text // JSON string of positions
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  sportProfiles     UserSportProfile[]
  pillarProgress    UserPillarProgress[]
  trajectoryRecords PerformanceTrajectoryRecord[]
  assessmentResults UserAssessmentResult[]

  @@map("sports")
}

// -------------------------------------------------------------
// 3. DIFFICULTY LEVELS
// -------------------------------------------------------------
model DifficultyLevel {
  id          String   @id // 'Beginner', 'Intermediate', 'Advanced'
  name        String   @unique
  label       String
  tagline     String
  description String   @db.Text
  rankOrder   Int      @default(1) @map("rank_order")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  sportProfiles     UserSportProfile[]
  pillarProgress    UserPillarProgress[]
  trajectoryRecords PerformanceTrajectoryRecord[]
  assessmentResults UserAssessmentResult[]

  @@map("difficulty_levels")
}

// -------------------------------------------------------------
// 4. USER SPORT PROFILES (USER + SPORT + DIFFICULTY LEVEL)
// -------------------------------------------------------------
model UserSportProfile {
  id                String @id @default(uuid())
  userId            String @map("user_id")
  sportId           String @map("sport_id")
  difficultyLevelId String @map("difficulty_level_id")

  position              String?
  height                String? @default("178 cm")
  weight                String? @default("68 kg")
  age                   Int?    @default(17)
  gender                String? @default("Male")
  location              String? @default("Manchester, UK")
  personalBest          String? @map("personal_best")
  preferredTrainingDays String? @map("preferred_training_days") @db.Text // JSON string
  trainingHours         String? @default("4 hours/week") @map("training_hours")
  trainingHoursNumber   Int     @default(4) @map("training_hours_number")
  goal                  String? @default("Improve performance")
  readiness             Int     @default(35)
  bio                   String? @db.Text
  sportsBackground      String? @map("sports_background") @db.Text
  strengths             String? @db.Text // JSON string
  focusAreas            String? @map("focus_areas") @db.Text // JSON string
  isCurrentSelected     Boolean @default(false) @map("is_current_selected")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Foreign keys
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport           Sport           @relation(fields: [sportId], references: [id], onDelete: Cascade)
  difficultyLevel DifficultyLevel @relation(fields: [difficultyLevelId], references: [id], onDelete: Cascade)

  // CRITICAL REQUIREMENT: Composite uniqueness for User + Sport + Difficulty Level
  @@unique([userId, sportId, difficultyLevelId], name: "user_sport_level_unique")
  @@index([userId, sportId])
  @@map("user_sport_profiles")
}

// -------------------------------------------------------------
// 5. BI-WEEKLY ASSESSMENT CYCLES
// -------------------------------------------------------------
model AssessmentCycle {
  id            String   @id @default(uuid())
  cycleNumber   Int      @map("cycle_number")
  title         String // e.g. "Cycle 1 (Jun 5 - Jun 18)"
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  durationWeeks Int      @default(2) @map("duration_weeks")
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, UPCOMING
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  assessmentResults UserAssessmentResult[]

  @@map("assessment_cycles")
}

// -------------------------------------------------------------
// 6. USER PILLAR PROGRESS (USER + SPORT + DIFFICULTY LEVEL)
// -------------------------------------------------------------
model UserPillarProgress {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  sportId           String   @map("sport_id")
  difficultyLevelId String   @map("difficulty_level_id")
  pillarType        String   @map("pillar_type") // TECHNICAL_SKILL, PHYSICAL_FITNESS, SPORT_IQ, TRAINING_CONSISTENCY
  pillarName        String   @map("pillar_name") // "Technical Skill", "Physical Fitness", etc.
  value             Int      @default(0)
  delta             Int      @default(0) // Bi-weekly change percentage
  targetValue       Int      @default(100) @map("target_value")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Foreign keys
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport           Sport           @relation(fields: [sportId], references: [id], onDelete: Cascade)
  difficultyLevel DifficultyLevel @relation(fields: [difficultyLevelId], references: [id], onDelete: Cascade)

  // CRITICAL REQUIREMENT: Composite uniqueness per Pillar for User + Sport + Difficulty Level
  @@unique([userId, sportId, difficultyLevelId, pillarType], name: "user_sport_level_pillar_unique")
  @@index([userId, sportId, difficultyLevelId])
  @@map("user_pillar_progress")
}

// -------------------------------------------------------------
// 7. PERFORMANCE TRAJECTORY RECORDS (USER + SPORT + DIFFICULTY LEVEL)
// -------------------------------------------------------------
model PerformanceTrajectoryRecord {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  sportId           String   @map("sport_id")
  difficultyLevelId String   @map("difficulty_level_id")
  cycleOrder        Int      @map("cycle_order") // 1, 2, 3, 4, 5...
  label             String // "Cycle 1", "Now", "Projected"
  recordedDate      String   @map("recorded_date") // "Jun 5", "Jul 17"
  score             Int // 0 - 100
  isCurrent         Boolean  @default(false) @map("is_current")
  isProjected       Boolean  @default(false) @map("is_projected")
  createdAt         DateTime @default(now()) @map("created_at")

  // Foreign keys
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport           Sport           @relation(fields: [sportId], references: [id], onDelete: Cascade)
  difficultyLevel DifficultyLevel @relation(fields: [difficultyLevelId], references: [id], onDelete: Cascade)

  // CRITICAL REQUIREMENT: Composite uniqueness per cycle point for User + Sport + Difficulty Level
  @@unique([userId, sportId, difficultyLevelId, cycleOrder], name: "user_sport_level_cycle_unique")
  @@index([userId, sportId, difficultyLevelId])
  @@map("performance_trajectory_records")
}

// -------------------------------------------------------------
// 8. ASSESSMENTS CATALOG
// -------------------------------------------------------------
model Assessment {
  id            String   @id // 'skills', 'fitness', 'knowledge', 'performance'
  slug          String   @unique
  title         String
  category      String
  description   String   @db.Text
  estimatedTime String   @map("estimated_time")
  badgeCategory String   @map("badge_category")
  items         String   @db.Text // JSON string array of assessment sub-items
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  userResults UserAssessmentResult[]

  @@map("assessments")
}

// -------------------------------------------------------------
// 9. USER ASSESSMENT RESULTS (USER + SPORT + DIFFICULTY LEVEL)
// -------------------------------------------------------------
model UserAssessmentResult {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  sportId           String    @map("sport_id")
  difficultyLevelId String    @map("difficulty_level_id")
  assessmentId      String    @map("assessment_id")
  cycleId           String?   @map("cycle_id")
  score             Int? // 0 - 100
  status            String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  completedAt       DateTime? @map("completed_at")
  breakdown         String?   @db.Text // JSON breakdown details

  // Foreign keys
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport           Sport            @relation(fields: [sportId], references: [id], onDelete: Cascade)
  difficultyLevel DifficultyLevel  @relation(fields: [difficultyLevelId], references: [id], onDelete: Cascade)
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  cycle           AssessmentCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([userId, sportId, difficultyLevelId])
  @@map("user_assessment_results")
}

// -------------------------------------------------------------
// 10. USER EVENT REGISTRATIONS & COMPETITION ARCHIVE
// -------------------------------------------------------------
model UserEventRegistration {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  eventId      String   @map("event_id")
  registeredAt DateTime @default(now()) @map("registered_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("user_event_registrations")
}

model UserCompetitionResult {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  eventId    String   @map("event_id")
  eventName  String   @map("event_name")
  sport      String
  location   String
  date       String
  status     String   @default("pending") // pending, completed
  placement  String?
  outcome    String?  @db.Text
  notes      String?  @db.Text
  recordedAt DateTime @default(now()) @map("recorded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_competition_results")
}
