# Athletex Backend Environment Variables Example

# Port the Express server listens on
PORT=5000

# Client origin for CORS (Frontend Vite dev server)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/athletex_db?schema=public"

# JWT Secret for access token signing
JWT_SECRET="athletex_jwt_ultra_secure_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Default Server-Side Seed Admin Credentials
ADMIN_EMAIL="admin@athletex.ai"
ADMIN_PASSWORD="adminPassword123"

# Node Environment
NODE_ENV="development"
